NODE_ENV=development
PORT=4100
# App database (Postgres / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/postgres
# crypt-iam's Redis — read only (realm secrets, permissions, token blacklist)
IAM_REDIS_URL=redis://default:password@host:6379
IAM_CLIENT_ID=mu
# Web app origins allowed to call the API and open sockets (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Images: "supabase" (public bucket, created on boot) or "local" (dev)
STORAGE_DRIVER=supabase
SUPABASE_URL=https://<project>.supabase.co
# Supabase → Settings → API → secret (service_role) key. Server-side only.
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=mu-media
# local driver only
LOCAL_STORAGE_PATH=uploads
PUBLIC_API_URL=http://localhost:4100

# MUMU RTC project (calls + live) — from the MUMU RTC console
MUMU_RTC_URL=https://mumu-rtc-backend.onrender.com
MUMU_RTC_API_KEY=mk_...
MUMU_RTC_API_SECRET=ms_...
RTC_TOKEN_TTL_SECONDS=3600
CALL_RING_SECONDS=45

# Per-account limits (per minute)
RATE_LIMIT_WRITES_PER_MIN=120
RATE_LIMIT_UPLOADS_PER_MIN=20
