{
  "name": "mumu-backend",
  "version": "1.0.0",
  "description": "MuMu \u2014 messaging-first social app on MUMU RTC (crypt-iam auth).",
  "keywords": [
    "ts"
  ],
  "homepage": "https://github.com/..#readme",
  "bugs": {
    "url": "https://github.com/../issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/...git"
  },
  "license": "ISC",
  "author": "abir-hosen",
  "main": "server.ts",
  "scripts": {
    "copy-locales": "cpx \"src/locales/**/*\" dist/src/locales",
    "dev": "nodemon --watch 'src/**/*.ts' --watch server.ts --exec 'ts-node' server.ts",
    "build": "prisma generate && tsc && npm run copy-locales",
    "start": "node dist/server.js",
    "test": "prisma migrate deploy && TS_NODE_TRANSPILE_ONLY=true node --test --test-concurrency=1 -r ts-node/register tests/*.test.ts",
    "generate-module": "ts-node scripts/generate-module.ts",
    "typecheck": "tsc --noEmit -p .",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "start:prod": "prisma migrate deploy && node dist/server.js",
    "iam:setup": "node scripts/iam-setup.mjs",
    "test:local": "set -a && . ./.env.test && set +a && pnpm test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@prisma/client-runtime-utils": "^7.3.0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "arg": "^4.1.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "create-require": "^1.1.1",
    "diff": "^4.0.4",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "i18next": "^25.8.4",
    "i18next-fs-backend": "^2.6.1",
    "i18next-http-middleware": "^3.9.2",
    "image-size": "^2.0.4",
    "jsonwebtoken": "^9.0.3",
    "make-error": "^1.3.6",
    "morgan": "^1.10.1",
    "multer": "^2.4.0",
    "pg": "^8.18.0",
    "redis": "^5.11.0",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "undici-types": "^7.16.0",
    "v8-compile-cache-lib": "^3.0.1",
    "winston": "^3.19.0",
    "yn": "^3.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/i18next": "^12.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.1.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cpx": "^1.5.0",
    "nodemon": "^3.1.11",
    "prisma": "^7.3.0",
    "socket.io-client": "^4.8.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
